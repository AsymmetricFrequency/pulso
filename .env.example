NODE_ENV=development
WEB_PORT=3000
API_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=https://pulso.my
SITE_URL=http://localhost:3000
MISSION_INVITATION_SECRET=replace-with-at-least-32-random-characters
IDENTITY_FINGERPRINT_SECRET=replace-with-a-different-32-character-secret
MISSION_ADMIN_KEY=replace-with-a-private-operations-key
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000
PERSISTENCE_DRIVER=memory
DATABASE_URL=postgres://pulso:pulso@localhost:5432/pulso
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info
SOURCE_INGESTION_ENABLED=false
PULSO_INCIDENT_CODE=colombia-2026
PULSO_INCIDENT_STARTED_AT=2026-08-10T07:34:00-05:00

# --- Panel administrativo (admin.pulso.my) ---------------------------------
# Sin estas variables la API arranca igual y /v1/admin/* responde 503 explicando qué falta.
# Los pasos para obtenerlas están en docs/34-discord.md, sección 4.
ADMIN_SESSION_SECRET=          # 32+ caracteres. openssl rand -base64 32
ADMIN_PANEL_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:3001

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=              # id del servidor de Pulso
DISCORD_BOT_TOKEN=             # credencial de producción: nunca al repositorio
DISCORD_REDIRECT_URI=http://localhost:3001/v1/admin/auth/callback
DISCORD_TASKS_CHANNEL_ID=      # opcional: canal de foro #tareas
DISCORD_WEBHOOK_ALERTS=        # opcional: webhook de #alertas

# Super admin: ids de Discord con escritura permanente, separados por coma. Resuelve el arranque
# —el rol Maintainer empieza vacío, así que sin esto la primera persona entra en modo lectura y no
# puede darse el rol que necesita para darse el rol— y la recuperación si alguien se equivoca
# repartiendo roles. Sigue exigiendo entrar por Discord con esa cuenta: no es una puerta trasera.
ADMIN_SUPERUSER_DISCORD_IDS=

# Entrada de emergencia, sin pasar por Discord. Mínimo 32 caracteres o se ignora en silencio.
# Quien tenga este valor entra con permisos completos: cada uso queda en el registro y la sesión
# dura dos horas. Dejarlo vacío desactiva la vía por completo.
ADMIN_BREAK_GLASS_TOKEN=
