{
  "name": "@pulso/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @pulso/schemas build && pnpm --filter @pulso/domain build",
    "test": "vitest run",
    "backfill:phone-fingerprints": "tsx src/backfill-phone-fingerprints.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@pulso/domain": "workspace:*",
    "@pulso/schemas": "workspace:*",
    "@simplewebauthn/server": "13.3.2",
    "fastify": "5.12.0",
    "postgres": "3.4.9",
    "uuid": "14.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
